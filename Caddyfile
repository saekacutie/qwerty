{
    admin off
    auto_https off
    servers {
        # Enables cleartext HTTP/2 (h2c) alongside HTTP/1.1 on the same
        # listener - this is the piece nginx structurally cannot do.
        protocols h1 h2c
    }
    # Third-party directives need an explicit position in Caddy's directive
    # order - this makes rate_limit run before any proxying happens.
    order rate_limit before reverse_proxy
}

:8080 {
    # Anti-DDoS: per-IP sliding-window limiter (verified real module:
    # github.com/mholt/caddy-ratelimit, built in via xcaddy - see Dockerfile).
    # 30 requests/sec/IP baseline, plus a stricter secondary zone that trips
    # on sustained abuse and holds the 429 for longer - this is the
    # "automatically stop serving an abusive client" behavior in practice:
    # once a client crosses the burst zone's threshold it keeps getting
    # rejected until its window rolls off, with no manual step needed.
    rate_limit {
        zone burst_per_ip {
            key    {http.request.remote.host}
            window 1s
            events 30
        }
        zone sustained_per_ip {
            key    {http.request.remote.host}
            window 60s
            events 600
        }
    }

    handle /health {
        respond "OK" 200
    }

    # --- TROJAN (longest/most specific prefixes first) ---
    handle /saeka-tojirp-grpc* {
        reverse_proxy 127.0.0.1:10012 {
            transport http {
                versions h2c 2
            }
        }
    }
    handle /saeka-tojirp-hu* {
        reverse_proxy 127.0.0.1:10001
    }
    handle /saeka-tojirp-xh* {
        reverse_proxy 127.0.0.1:10002
    }
    handle /saeka-tojirp* {
        reverse_proxy 127.0.0.1:10000
    }

    # --- VMESS ---
    handle /vmess-saeka-grpc* {
        reverse_proxy 127.0.0.1:10013 {
            transport http {
                versions h2c 2
            }
        }
    }
    handle /vmess-saeka-hu* {
        reverse_proxy 127.0.0.1:10004
    }
    handle /vmess-saeka-xh* {
        reverse_proxy 127.0.0.1:10005
    }
    handle /vmess-saeka* {
        reverse_proxy 127.0.0.1:10003
    }

    # --- VLESS ---
    handle /vless-saeka-grpc* {
        reverse_proxy 127.0.0.1:10014 {
            transport http {
                versions h2c 2
            }
        }
    }
    handle /vless-saeka-hu* {
        reverse_proxy 127.0.0.1:10007
    }
    handle /vless-saeka-xh* {
        reverse_proxy 127.0.0.1:10008
    }
    handle /vless-saeka* {
        reverse_proxy 127.0.0.1:10006
    }

    # --- SHADOWSOCKS ---
    handle /ss-saeka-grpc* {
        reverse_proxy 127.0.0.1:10015 {
            transport http {
                versions h2c 2
            }
        }
    }
    handle /ss-saeka-hu* {
        reverse_proxy 127.0.0.1:10010
    }
    handle /ss-saeka-xh* {
        reverse_proxy 127.0.0.1:10011
    }
    handle /ss-saeka* {
        reverse_proxy 127.0.0.1:10009
    }

    handle {
        root * /var/www/html
        file_server
        log_skip
    }
}
